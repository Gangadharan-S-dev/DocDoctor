{
  "name": "docdoctor",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . && tsc --noEmit",
    "lint:types": "tsc --noEmit",
    "test": "node tests/pdf-engine.test.mjs && node tests/office.test.mjs && node tests/advanced.test.mjs && node tests/crypto.test.mjs && npm run test:unit",
    "test:unit": "vitest run",
    "test:server": "node tests/server.test.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "docx": "^9.15.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.69.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "image-size": "^2.0.4",
    "minimatch": "^11.0.4"
  }
}
