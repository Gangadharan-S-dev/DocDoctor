{
  "name": "docdoctor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node tests/pdf-engine.test.mjs && node tests/office.test.mjs && node tests/advanced.test.mjs && node tests/crypto.test.mjs",
    "test:server": "node tests/server.test.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "docx": "^9.15.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
